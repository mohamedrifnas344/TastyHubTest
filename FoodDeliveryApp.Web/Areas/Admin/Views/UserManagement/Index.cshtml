@model List<FoodDeliveryApp.Application.ViewModels.UserManagement.UserResponseVM>

@{
    ViewData["Title"] = "User List";
}


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-dark fw-bold">User Management</h1>
            <p class="text-muted small mb-0">Manage system users, view their assigned roles , and monitor account status.</p>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="table-light text-uppercase fs-6 text-muted">
                    <tr>
                        <th scope="col" class="ps-4">User Id</th>
                        <th scope="col">Fullname</th>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null && Model.Any())
                    {
                        @foreach(var user in Model)
                        {
                            <tr>
                                <td class="ps-4">@user.Id</td>
                                <td class="text-secondary fw-semibold">
                                    @user.FirstName @user.LastName
                                </td>
                                <td class="text-secondary fw-semibold">@user.UserName</td>
                                <td class="text-secondary fw-semibold">@user.Emain</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                                        @user.Role
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 card-body mb-2"></i>
                                No Users Found in System.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
