@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentStatus = Context.Request.Query["status"].ToString();

    string GetActiveClass(string controller , string action = "Index" , string status = null)
    {
        bool matchController = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool matchAction = string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        bool matchStatus = string.Equals(currentStatus, status, StringComparison.OrdinalIgnoreCase);
        bool isActive = false;

        if (!string.IsNullOrEmpty(status))
        {
            isActive = matchController && matchStatus;
        }
        else
        {
            isActive = matchController && matchAction;
        }

        return isActive ? "active bg-primary-subtle text-primary fw-bold border-start border-3 border-primary rounded-end" :
        "text-secondary";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodDeliveryApp.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodDeliveryApp.Web.styles.css" asp-append-version="true" />
    <link rel=" stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
</head>
<body class="bg-light-subtle text-dark">
    
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-3">
        <div class="container-fluid px-4">
            <button type="button" class="btn btn-light border d-lg-none me-3"
            data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                <i class="bi bi-text-left fs-4"></i>
            </button>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                class="navbar-brand fw-bold fs-4 d-flex align-items-center text-danger text-decoration-none text-uppercase">
                <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded-3 me-2"
                style="width: 38px; height: 38px;">
                    <i class="bi bi-lightning fs-5"></i>
                </div>
                <span class="fw-bold">Tasty<span class="text-primary">Hub</span></span>
            </a>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <div class="vr mx-2 text-muted opacity-25"></div>
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center gap-2 p-1 text-danger"
                    data-bs-toggle="dropdown">
                        <div class="bg-secondary-subtle rounded-circle d-flex align-items-center justify-content-center 
                        fw-bold text-uppercase" style="width:38px; height: 38px; font-size: 0.85rem;">
                            AU
