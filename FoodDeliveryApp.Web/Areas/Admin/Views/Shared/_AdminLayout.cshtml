            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="offcanvas-body p-3">
            <div class="text-muted text-uppercase fw-bold mb-3 px-2"
            style="font-size: 0.7rem; letter-spacing: 1px;">
                Management
            </div>

            <ul class="nav flex-column mb-4 gap-1">
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="nav-link px-3 py-2 text-decoration-none">
                        <i class="bi bi-speedometer2 me-3"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                       class="nav-link px-3 py-2 text-decoration-none">
                        <i class="bi bi-tags me-3"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="MenuItem" asp-action="Index"
                       class="nav-link px-3 py-2 text-decoration-none">
                        <i class="bi bi-box-seam me-3"></i> MenuItems
                    </a>
                </li>
            </ul>

            <div class="text-muted text-uppercase fw-bold mb-3 mt-4 px-2"
                 style="font-size: 0.7rem; letter-spacing: 1px;">
                Sales & Customers
            </div>

            <ul class="nav flex-column mb-4 gap-1">
                <li class="nav-item">
                    <button class="nav-link w-100 text-start d-flex justify-content-between align-items-center
                        border-0 bg-transparent text-secondary px-3 py-2"
                            data-bs-toggle="collapse" href="#desktopOrderSidebar" role="button"
                            aria-expanded="@(currentController == "Order" ? "true" : "false")">
                        <span>
                            <i class="bi bi-receipt me-3"></i> Orders
                        </span>
                        <i class="bi bi-chevron-down small opacity-50"></i>
                    </button>

                    <div class="collapse @(currentController == "Order" ? "show" : "")"
                         id="desktopOrderSidebar">
                        <ul class="nav flex-column mt-1 gap-1 ps-3 border-start ms-3 border-light-subtle">
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" 
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "")">
                                    All Orders
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Pending"
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "Pending")">
                                    <span class="badge bg-warning-subtle text-warning me-2"
                                          style="width: 8px; height: 8px; border-radius: 8px; padding: 0; display: inline-block;">
                                    </span> Pending
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Confirmed"
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "Confirmed")">
                                    <span class="badge bg-primary-subtle text-warning me-2"
                                          style="width: 8px; height: 8px; border-radius: 8px; padding: 0; display: inline-block;">
                                    </span> Confirmed
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Preparing"
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "Preparing")">
                                    <span class="badge bg-info-subtle text-warning me-2"
                                          style="width: 8px; height: 8px; border-radius: 8px; padding: 0; display: inline-block;">
                                    </span> Preparing
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="OutForDelivery"
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "OutForDelivery")">
                                    <span class="badge bg-success-subtle text-warning me-2"
                                          style="width: 8px; height: 8px; border-radius: 8px; padding: 0; display: inline-block;">
                                    </span> OutForDelivery
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Delivered"
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "Delivered")">
                                    <span class="badge bg-success-subtle text-warning me-2"
                                          style="width: 8px; height: 8px; border-radius: 8px; padding: 0; display: inline-block;">
                                    </span> Delivered
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Cancelled"
                                    class="nav-link px-3 small py-2 text-decoration-none d-block
                                    @GetActiveClass("Order", "Index", "Cancelled")">
                                    <span class="badge bg-danger-subtle text-warning me-2"
                                          style="width: 8px; height: 8px; border-radius: 8px; padding: 0; display: inline-block;">
                                    </span> Cancelled
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                        class="nav-link px-3 py-2 text-decoration-none
                        @GetActiveClass("UserManagement", "Index")">
                        <i class="bi bi-people me-3"></i> Users
                    </a>
                </li>
            </ul>
        </div>
     </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
