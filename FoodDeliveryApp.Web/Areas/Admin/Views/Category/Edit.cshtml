@model FoodDeliveryApp.Application.ViewModels.Category.CategoryEditVM

@{
    ViewData["Title"] = "Update Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-6">
            <div class="card border border-light-subtle shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-light border-0 py-4 px-4 px-md-5">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold text-dark">Update Category</h4>
                            <p class="text-muted small mb-0">Update category details and image.</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post"
                          asp-area="Admin" asp-controller="Category" asp-action="Edit"
                          enctype="multipart/form-data"
                    >
                        <input type="hidden" asp-for="Id"/>
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary small text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-tag"></i>
                                </span>
                                <input asp-for="Name" class="form-control border-start-0 ps-0 py-2"
                                       placeholder="e.g Fast food , Desserts , Italian" />
                            </div>
                            <span asp-validation-for="Name" class="d-block mt-1 text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="File" class="form-label fw-semibold text-secondary small text-uppercase"></label>
                            <input type="file" asp-for="File" id="imageUpload" class="d-none" />

                            <div id="uploadBox" class="border border-2 border-secondary-subtle rounded-4 p-4
                                text-center bg-light bg-opacity-50 text-secondary" style="cursor:pointer;">
                                <div id="previewContainer">
                                    <img src="@Model.ExistingImageUrl" class="img-fluid shadow-sm rounded-2 border"
                                         style="max-height: 300px; object-fit: cover;" />
                                    <p class="small text-primary mt-2 mb-0 fw-medium">
                                        <i class="bi bi-arrow-repeat me-1"></i> Change Image
                                    </p>
                                </div>
                            </div>
                            <span asp-validation-for="File" class="d-block mt-1 text-danger"></span>
                        </div>

                        <hr class="my-3 opacity-25" />

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">
                            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                                class="btn btn-outline-secondary px-4 py-2 rounded-3 order-2 order-sm-1 shadow-sm">
                                <i class="bi bi-arrow-left me-2"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 order-1 order-sm-2 shadow-sm">
                                <i class="bi bi-check-lg me-2"></i> Update Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function(){
            $('#uploadBox').click(function(){
              $('#imageUpload').click();
            })

            $('#imageUpload').change(function(e){
                const file = e.target.files[0];
                if(file){
                    const reader = new FileReader();
                    reader.onload = function(e){
                        $('#previewContainer img').attr('src' , e.target.result);
                    }
                    reader.readAsDataURL(file);
                }
            });
        })
    </script>
}

