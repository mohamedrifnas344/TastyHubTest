@model List<FoodDeliveryApp.Application.ViewModels.Category.CategoryResponseVM>
@{
    ViewData["Title"] = "Category List";
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-semibold">Category Management</h5>
            <small class="text-muted">Manage all product categories</small>
        </div>
        <a asp-area="Admin" asp-controller="Category" asp-action="Add"
            class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-plus-lg"></i> Add Category
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            @if(Model != null && Model.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th class="text-start ps-4">Category Name</th>
                            <th class="text-start ps-4">Image</th>
                            <th style="width : 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var category in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@category.Name</td>
                                <td class="ps-4">
                                    <img src="@category.ImageUrl" alt="@category.Name" 
                                    class="object-fit-cover" style="width: 90px ; height:90px; border-radius: 90px;"/>
                                </td>
                                <td class="text-center">
                                    <a asp-area="Admin" 
                                       asp-controller="Category" 
                                       asp-action="Edit" 
                                       asp-route-id="@category.Id"
                                        class="btn btn-outline-warning me-2">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-area="Admin" 
                                          asp-controller="Category" 
                                          asp-action="Delete" 
                                          asp-route-id="@category.Id" method="post"
                                        class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-5 text-muted"></i>
                    <h5 class="mt-3">No Categories Found</h5>

                    <p class="text-muted">Start by adding your first category</p>
                    <a class="btn btn-primary mt-2">
                        <i class="bi bi-plus-lg"></i> Add Category
                    </a>
                </div>
            }
        </div>
    </div>
</div>
