@model FoodDeliveryApp.Application.ViewModels.Dashboard.DahsboardVM

@{
    ViewData["Title"] = "Dashboard";
}


<div class="container py-4">
    <div class="d-flex flex-sm-row flex-column justify-content-between align-items-start align-items-sm-start mb-4 
    border-bottom gap-3">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark">Admin Dashboard</h1>
            <p class="text-muted small mb-0">Real-time overview of your application analytics</p>
        </div>
        <button class="btn btn-close-white border shadow-sm btn-sm d-flex align-items-center gap-2 fw-semibold px-3 
        py-2 text-secondary" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwice fs-6 text-primary"></i> Refresh Data
        </button>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-4 mb-4">

        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-top border-3 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="bg-success bg-opacity-10 text-success rounded px-2 py-1">
                            <i class="bi bi-currency-dollar fw-bold"></i>
                        </div>
                        <small class="text-uppercase fw-bold text-muted">Total Revenue</small>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">$@Model.TotalRevenue.ToString("F2")</h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-top border-3 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="bg-success bg-opacity-10 text-success rounded px-2 py-1">
                            <i class="bi bi-bag-check-fill fw-bold"></i>
                        </div>
                        <small class="text-uppercase fw-bold text-muted">Total Orders</small>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-top border-3 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="bg-success bg-opacity-10 text-success rounded px-2 py-1">
                            <i class="bi bi-egg-fried fw-bold"></i>
                        </div>
                        <small class="text-uppercase fw-bold text-muted">Total Menus</small>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalMenuItems</h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-top border-3 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="bg-success bg-opacity-10 text-success rounded px-2 py-1">
                            <i class="bi bi-tags-fill fw-bold"></i>
                        </div>
                        <small class="text-uppercase fw-bold text-muted">Total Categories</small>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalCategories</h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm border-0 border-top border-3 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="bg-success bg-opacity-10 text-success rounded px-2 py-1">
                            <i class="bi bi-people-fill fw-bold"></i>
                        </div>
                        <small class="text-uppercase fw-bold text-muted">Total Users</small>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Revenue Streams</h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">USD ($)</span>
                </div>
                <div style="height: 300px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Order Demand</h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Volume</span>
                </div>
                <div style="height: 300px;">
                    <canvas id="orderChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="fw-bold text-dark mb-4">Order Status</h5>
                <div style="height: 240px;">
                    <canvas id="orderPiChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="fw-bold text-dark mb-4">Payment Status</h5>
                <div style="height: 240px;">
                    <canvas id="paymentPiChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script>
        $(document).ready(function(){

            var monthNames = ["Jan" , "Feb" , "Mar" , "Apr" , "May" , "Jun" , "Jul" , "Aug" , "Sep" , "Oct" , "Nov" , "Dec"];
            var labels = [];
            let today = new Date();
            for(let i = 5; i >= 0; i--){
                let d = new Date(today.getFullYear() , today.getMonth() - i , 1);
                labels.push(monthNames[d.getMonth()] + " " + d.getFullYear());
            }

            Chart.defaults.plugins.legend.labels.usePointStyle = true;
            Chart.defaults.plugins.legend.labels.boxWidth = 10;

            // Revenue Chart
            new Chart($('#revenueChart')[0].getContext('2d') , {
                type : 'line',
                data : {
                    labels : labels,
                    datasets : [{
                        label : 'Revenue',
                        data : @Html.Raw(Json.Serialize(Model.MonthlyRevenue)),
                        backgroundColor : 'rgba(25 , 135 , 84 , 0.05)',
                        borderColor : '#198754',
                        fill : true,
                        tension : 0.25
                    }]
                },
                options : {
                    responsive : true,
                    maintainAspectRatio : false,
                    plugins : {
                        legend : {
                            display : false
                        }
                    }
                }
            });

            // Order Chart
            new Chart($('#orderChart')[0].getContext('2d') , {
                type : 'line',
                data : {
                    labels : labels,
                    datasets : [{
                        label : 'Orders',
                        data : @Html.Raw(Json.Serialize(Model.MonthlyOrders)),
                        backgroundColor : 'rgba(13 , 110 , 253 , 0.05)',
                        borderColor : '#0d6efd',
                        fill : true,
                        tension : 0.25
                    }]
                },
                options : {
                    responsive : true,
                    maintainAspectRatio : false,
                    plugins : {
                        legend : {
                            display : false
                        }
                    }
                }
            });

            // Order Pie Chart
            new Chart($('#orderPiChart')[0].getContext('2d') , {
                type : 'doughnut',
                data : {
                    labels : ['Pending' , 'Confirmed' , 'Preparing' , 'Out For Delivery' , 'Delivered' , 'Cancelled'],
                    datasets : [{
                        data : [
                            @Model.PendingOrders , @Model.ConfirmOrders , @Model.PreparingOrders,
                            @Model.OutForDeliveryOrders , @Model.DeliveredOrders , @Model.CancellOrders
                        ],
                        backgroundColor : ['#6c757d' , '#10c469' , '#f9c851' , '#ff6b6b' , '#50a5d8' , '#ff9f40'],
                        borderWidth : 2,
                    }]
                },
                options : {
                    responsive : true,
                    maintainAspectRatio : false,
                    plugins : {
                        legend : {
                            position : 'right'
                        }
                    }
                }
            });

             // Payment Pie Chart
            new Chart($('#paymentPiChart')[0].getContext('2d') , {
                type : 'doughnut',
                data : {
                    labels : ['Pending' , 'Confirmed' , 'Failed'],
                    datasets : [{
                        data : [@Model.PendingPaymnts , @Model.ConfirmPayments , @Model.CancellPayments],
                        backgroundColor : ['#198754' , '#ffc107' , '#dc3545'],
                        borderWidth : 2,
                    }]
                },
                options : {
                    responsive : true,
                    maintainAspectRatio : false,
                    plugins : {
                        legend : {
                            position : 'right'
                        }
                    }
                }
            });
        });
    </script>
}