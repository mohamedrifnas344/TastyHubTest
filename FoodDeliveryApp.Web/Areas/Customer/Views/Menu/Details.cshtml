@model FoodDeliveryApp.Application.ViewModels.MenuItem.MenuItemResponseVM

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4 py-md-5">
    <div class="row mb-4">
        <div class="col">
            <a asp-area="Customer" asp-controller="Menu" asp-action="Index"
                class="btn btn-link link-secondary text-decoration-none p-0 d-inline-flex align-items-center gap-2 fw-semibold">
                <i class="bi bi-arrow-left"></i> Back to Menu
            </a>
        </div>
    </div>
    <div class="row g-4 g-lg-5">

        <div class="col-md-6">
            <div class="sticky-md-top pt-md-2">
                <div class="shadow-sm rounded-4 overflow-hidden border border-light-subtle">
                    <img src="@Model.ImageUrl" alt="@Model.Name"
                    class="img-fluid w-100 object-fit-cover" style="height: 450px;"/>
                </div>
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-between">
            <div class="mb-4">
                <div class="mb-3">
                    <span class="badge bg-body-secondary text-dark border border-secondary-subtle rounded-pill 
                    px-3 py-2 text-uppercase fw-semibold"
                    style="font-size: 0.75rem;">
                        <i class="bi bi-tag-fill me-1 text-primary"></i> @Model.CategoryName
                    </span>
                </div>
                <h1 class="fw-bold text-dark mb-3 display-6 font-monospace">@Model.Name</h1>
                <div class="d-flex align-items-baseline gap-3 mb-4">
                    @if(Model.SpecialPrice.HasValue && Model.SpecialPrice < Model.Price)
                    {
                        <span class="fs-1 fw-bold text-danger">
                            $@Model.SpecialPrice.Value.ToString("0.00")
                        </span>
                        <span class="fs-4 text-body-tertiary text-decoration-line-through fw-light">
                            $@Model.Price.ToString("0.00")
                        </span>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1 fs-6 fw-semibold">
                            PROMO
                        </span>
                    }
                    else
                    {
                        <span class="fs-1 fw-bold text-dark">$@Model.Price.ToString("0.00")</span>
                    }
                </div>

                <hr class="my-4 opacity-25"/>

                <h6 class="text-uppercase fw-bold text-secondary-emphasis mb-2 small">Description</h6>
                <p class="text-muted lh-lg fs-6 mb-4">@Model.Description</p>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle">
                            <span class="text-muted d-block text-uppercase">Preparation</span>
                            <span class="fw-semibold text-dark small">
                                <i class="bi bi-clock me-1"></i> Freshly Prepared
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle">
                            <span class="text-muted d-block text-uppercase small">Delivery</span>
                            <span class="fw-semibold text-dark small">
                                <i class="bi bi-bicycle me-1"></i> Instant Dispatch
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 bg-body border border-light-subtle rounded-4 shadow-sm">
                <div class="row g-3 align-items-end">
                    <div class="col-sm-5">
                        <label for="quantity" class="form-label text-dark small fw-bold mb-2">
                            Select Quantity
                        </label>
                        <div class="d-flex align-items-center border border-secondary-subtle rounded-3 bg-light p-1">
                            <button type="button" class="btn btn-link text-dark shadow p-2 border-0"
                            id="btn-minus">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <span class="text-center fw-bold bg-transparent shadow-none fs-5 py-2 px-4"
                            id="cartQty"></span>
                            <button type="button" class="btn btn-link text-dark shadow p-2 border-0"
                                    id="btn-plus">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <button type="button" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold py-2 d-flex 
                        align-items-center justify-content-center gap-2 fs-6 shadow"
                        id="btnDetailsAddToCart" data-menuitemid="@Model.Id">
                            <i class="bi bi-bag-plus"></i> Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script>
        $(document).ready(function(){

            var qtyInput = $('#cartQty');
            qtyInput.text(1);

            $('#btn-plus').click(function(){
                var currentValue = parseInt(qtyInput.text());
                qtyInput.text(currentValue+1);
            })

            $('#btn-minus').click(function(){
                var currentValue = parseInt(qtyInput.text());
                if(currentValue > 1){
                    qtyInput.text(currentValue - 1);
                }
            })
        })
    </script>
}