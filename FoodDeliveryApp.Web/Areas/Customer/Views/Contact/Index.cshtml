
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">Visit & Contact Us</h1>
        <p class="text-muted col-md-6 mx-auto">We'd love to host you! Drop by an unforgettable during experience, or 
            get in touch recervation , catering and events.</p>
    </div>
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100 bg-white">
                <h3 class="h4 fw-semibold text-dark mb-4">Our Location</h3>

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-light text-dark rounded p-2 me-3 d-flex align-items-center justify-content-center"
                    style="width: 44px; height: 44px;">
                        <i class="bi bi-geo-alt fs-5"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold text-dark">Address</h6>
                        <p class="text-muted small mb-0">24 Abovyan St, Yerevan 001 , Armenia</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-light text-dark rounded p-2 me-3 d-flex align-items-center justify-content-center"
                         style="width: 44px; height: 44px;">
                        <i class="bi bi-telephone-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold text-dark">Reservation & Info</h6>
                        <p class="text-muted small mb-0">tel : +371234567890</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-4">
                    <div class="bg-light text-dark rounded p-2 me-3 d-flex align-items-center justify-content-center"
                         style="width: 44px; height: 44px;">
                        <i class="bi bi-envelope fs-5"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold text-dark">Catering & Events</h6>
                        <p class="text-muted small mb-0">events@domain.am</p>
                    </div>
                </div>

                <hr class="text-muted my-4"/>

                <div>
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-clock me-2"></i> Opening Hours
                    </h6>
                    <div>
                        <span>Monday - Thursday</span>
                        <span>11:00 AM - 10:00 PM</span>
                    </div>
                    <div>
                        <span>Friday - Saturday</span>
                        <span>12:00 PM - 11:00 PM</span>
                    </div>
                    <div>
                        <span>Sunday</span>
                        <span>Closed</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 overflow-hidden h-100 bg-white"
            style="min-height: 400px;">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3048.
                1643444458316!2d44.51475717657218!3d40.
                18311397147824!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!
                1s0x406abce2913e6341%3A0x7d0a6df314a5b28d!2sAbovyan%20St%2C%20Yerevan%2C%20Armenia!5e0!3m2!1sen!2s!
                4v1717690000000!5m2!1sen!2s"
                class="w-100 h-100 border-0"
                allowfullscreen=""
                loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>
