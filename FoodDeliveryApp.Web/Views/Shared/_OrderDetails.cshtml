@model FoodDeliveryApp.Application.ViewModels.Order.OrderResponseVM

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body d-flex justify-content-between align-items-center bg-light rounded">
                <div class="d-flex flex-column gap-2">
                    <div>
                        <span class="text-muted d-block small text-uppercase fw-bold">Order Date</span>
                        <span class="fw-semibold">@Model.OrderDate.ToString("MMM dd, yyy hh:mm tt")</span>
                    </div>
                    <div>
                        <span class="text-muted d-block small text-uppercase fw-bold">Payment Date</span>
                        <span class="fw-semibold">
                            @(Model.PaymentDate.HasValue ? Model.PaymentDate.Value.ToString("MMM dd, yyy hh:mm tt") : "N/A")
                        </span>
                    </div>
                </div>
                <div class="text-end">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">Status</span>
                    <p>
                        <span class="fw-bold">Order : </span>
                        <span class="badge bg-primary px-3 py-2 rounded-pill fs-6">@Model.OrderStatus</span>
                    </p>
                    <p>
                        <span class="fw-bold">Payment : </span>
                        <span class="badge bg-success px-3 py-2 rounded-pill fs-6">@Model.PaymentStatus</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 card-title fw-bold">Items Ordered (@Model.TotalItems)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Item</th>
                                <th scope="col" class="text-center">Price</th>
                                <th scope="col" class="text-center">Quantity</th>
                                <th scope="col" class="text-end pe-4">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center py-2">
                                            <img src="@item.MenuItemImageUrl" alt="@item.MenuItemName"
                                            class="rounded me-3 shadow-sm" 
                                            style="width: 60px; height: 60px; object-fit: cover;"/>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@item.MenuItemName</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">$@item.Price.ToString("F2")</td>
                                    <td class="text-center fw-medium">@item.Quantity</td>
                                    <td class="text-end pe-4 fw-bold">$@item.SubTotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 card-title fw-bold">Delivery Details</h5>
            </div>
            <div class="card-body">
                <h6 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h6>
                <p class="text-muted mb-3 small">@Model.Email</p>

                <hr class="text-muted opacity-25"/>

                <p class="mb-1 fw-semibold">
                    <i class="bi bi-geo-alt me-2 text-primary"></i> Address
                </p>
                <p class="text-muted mb-3 small ms-4">
                    @Model.Street <br/>
                    @Model.City , @Model.PostalCode
                </p>

                <p class="mb-1 fw-semibold">
                    <i class="bi bi-telephone me-2 text-primary"></i> Contact
                </p>
                <p class="text-muted mb-3 small ms-4">
                    @Model.Phone1
                    @if (!string.IsNullOrEmpty(Model.Phone2))
                    {
                        <span> / @Model.Phone2</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(Model.DeliveryInstructions))
                {
                    <hr class="text-muted opacity-25"/>
                    <p class="mb-1 fw-semibold text-warning">
                        <i class="bi bi-info-circle me-3"></i> Instructions
                    </p>
                    <blockquote class="blockquote blockquote-footer bg-light p-2 rounded mb-0 mt-1 text-dark fs-6">
                        @Model.DeliveryInstructions
                    </blockquote>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 card-title fw-bold">Payment Summary</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">SubTotal</span>
                    <span>$@Model.TotalPrice.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Delivery Fee</span>
                    <span>$@Model.DeliveryFee.ToString("F2")</span>
                </div>
                <hr class="my-3"/>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">Grand Total</span>
                    <span class="fw-bold fs-4 text-primary">$@Model.GrandTotal.ToString("F2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
