@model List<FoodDeliveryApp.Application.ViewModels.MenuItem.MenuItemResponseVM>


@if (!Model.Any())
{
    <div class="text-center py-5 my-4 mx-auto">
        <div class="bg-light d-inline-flex p-4 rounded-circle mb-3 border-light-subtle">
            <i class="bi bi-egg-fried text-muted display-4"></i>
        </div>
        <h4 class="fw-bold text-dark">No dishes found</h4>
        <p class="text-muted small">Try tweaking search , filters or check back later!</p>
    </div>
}


@foreach(var item in Model)
{
    <div class="col menu-item-card">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white position-relative 
        text-decoration-none text-reset border-top border-light opacity-100 transition-all traslate-middle-y-hover">

            <div class="position-relative ratio ratio-4x3 bg-light overflow-hidden">
                <a asp-area="Customer" asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id"
                    class="d-block w-100 h-100">
                    <img src="@item.ImageUrl" alt="@item.Name"
                    class="w-100 h-100 object-fit-cover" loading="lazy"/>
                </a>
            </div>

            <div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">

                <div class="mb-3">
                    <div class="mb-1 text-uppercase">
                        <span class="text-danger fw-bold small" style="font-size: 0.75rem;">
                            @item.CategoryName
                        </span>
                    </div>
                    <h6 class="fw-bold text-dark mb-2 text-truncate">@item.Name</h6>
                    <p class="text-muted small mb-0 text-truncate text-wrap"
                    style="max-height: 2.8rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; 
                    -webkit-box-orient: vertical;">
                        @item.Description
                    </p>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-3 border-top border-light-subtle">
                    <div class="d-flex gap-2">
                        @if (item.SpecialPrice.HasValue)
                        {
                            <span class="text-muted text-decoration-line-through small lh-1"
                            style="font-size: 0.75rem;">$@string.Format("{0:F2}" , item.Price)</span>
                            <span class="fs-5 fw-bold text-danger lh-1">$@string.Format("{0:F2}", item.SpecialPrice)</span>
                        }
                        else
                        {
                            <span class="fs-5 fw-bold text-dark lh-1">$@string.Format("{0:F2}", item.Price)</span>
                        }
                    </div>
                    <div class="d-flex align-items-center">

                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-bold text-nowrap 
                        d-flex align-items-center gap-2 transition-all btnAddToCart
                        @(item.QuantityInCart > 0 ? "d-none" : "")"
                        data-menuitemid = "@item.Id">
                            <i class="bi bi-bag-plus-fill"></i>
                        </button>
                        <div class="d-flex align-items-center border border-danger bg-white rounded-pill p-1 qty-box
                            @(item.QuantityInCart > 0 ? "" : "d-none")">
                            <button class="btn btn-danger btn-sm rounded-circle d-flex align-items-center 
                                justify-content-center p-0 decrease" disabled="@item.QuantityInCart <= 1"
                                    style="width: 24px; height: 24px;" data-menuitemid="@item.Id">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="mx-3 fw-bold text-danger qty">@item.QuantityInCart</span>
                            <button class="btn btn-danger btn-sm rounded-circle d-flex align-items-center
                                justify-content-center p-0 increase" style="width: 24px; height: 24px;"
                                data-menuitemid="@item.Id">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<style>
    .transition-all{
        transition: all 0.3s cubic-bezier(0.25 , 0.8 , 0.25 , 1);
    }

    .traslate-middle-y-hover:hover{
        transform: translate(-3px);
        box-shadow: 0 5px 10px rgba(0 , 0 , 0 , 0.12);
    }
</style>